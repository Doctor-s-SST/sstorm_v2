    "/api/certificados": {
      "post": {
        "tags": [
          "Documentos"
        ],
        "summary": "Inicia a geração de certificados de treinamento",
        "description": "**Tela:** Gerar Certificado.\n\n**Variável do webhook:** `N8N_CERTIFICADO_URL`.",
        "security": [
          {
            "sessao": []
          }
        ],
        "responses": {
          "200": {
            "description": "Geração iniciada."
          },
          "500": {
            "description": "Erro interno ou falha no n8n.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        },
        "x-n8n-env": [
          "N8N_CERTIFICADO_URL"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "requestId",
                  "treinamento",
                  "funcionarios",
                  "dataTreinamento",
                  "horaInicio",
                  "horaFim",
                  "empresaTreinamento",
                  "endereco"
                ],
                "properties": {
                  "requestId": {
                    "type": "string",
                    "example": "00000000-0000-4000-8000-000000000000",
                    "format": "uuid"
                  },
                  "treinamento": {
                    "type": "string",
                    "example": "certificado-nr35",
                    "enum": [
                      "certificado-nr06",
                      "certificado-nr18-basico",
                      "certificado-nr35"
                    ]
                  },
                  "funcionarios": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "example": "Funcionario Exemplo"
                    }
                  },
                  "empresas": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "example": "Empresa Exemplo"
                    }
                  },
                  "dataTreinamento": {
                    "type": "string",
                    "format": "date",
                    "example": "2026-10-20"
                  },
                  "horaInicio": {
                    "type": "string",
                    "example": "08:00"
                  },
                  "horaFim": {
                    "type": "string",
                    "example": "12:00"
                  },
                  "empresaTreinamento": {
                    "type": "string",
                    "example": "Empresa Exemplo"
                  },
                  "endereco": {
                    "type": "string",
                    "example": "Endereço do treinamento"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/certificados-download": {
      "get": {
        "tags": [
          "Documentos"
        ],
        "summary": "Baixa os certificados gerados",
        "description": "**Tela:** Gerar Certificado.\n\n**Variável do webhook:** `N8N_CERTIFICADOS_DOWNLOAD_URL`.",
        "security": [
          {
