{
  "openapi": "3.0.3",
  "info": {
    "title": "SSTORM Doctors – API",
    "version": "1.0.0",
    "description": "Rotas de servidor do SSTORM (Next.js, `src/app/api`). Elas repassam as requisições a webhooks do n8n.\n\n**Sessão:** cookie httpOnly `session`, gravado por `POST /api/auth/login`. O proxy de rotas valida esse token no n8n em todas as rotas marcadas com cadeado e responde 401 quando a sessão é inválida ou 503 quando a validação não pode ser feita.\n\n**Públicas:** somente login, cadastro e logout dispensam sessão.\n\n**Standby:** as rotas de e-mail em massa, administradoras e assinador estão bloqueadas e não constam nesta especificação.\n\n**n8n:** cada operação informa em `x-n8n-env` o nome da variável de ambiente que guarda a URL do webhook. Endereços e chaves não são publicados aqui."
  },
  "servers": [
    {
      "url": "https://{hostSistema}",
      "variables": {
        "hostSistema": {
          "default": "host-do-sistema",
          "description": "Endereço do SSTORM no ambiente"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "Autenticação",
      "description": "Login, sessão, cadastro, perfil e senha"
    },
    {
      "name": "AEP",
      "description": "Relatório psicossocial e e-mail de acesso ao questionário"
    },
    {
      "name": "Documentos",
      "description": "Documentos de condomínio, relatórios Contele e certificados de treinamento"
    },
    {
      "name": "Heali",
      "description": "Acompanhamento dos programas AEP"
    },
    {
      "name": "Atendimentos",
      "description": "Processamento do relatório de atendimentos"
    }
  ],
  "paths": {
    "/api/auth/login": {
      "post": {
        "tags": [
          "Autenticação"
        ],
        "summary": "Autentica o usuário e grava o cookie de sessão",
        "description": "**Tela:** Login.\n\n**Variável do webhook:** `N8N_AUTH_LOGIN_URL`.",
        "security": [],
        "responses": {
          "200": {
            "description": "Sucesso; grava o cookie httpOnly \"session\" com o token devolvido pelo n8n."
          },
          "500": {
            "description": "Erro interno ou falha no n8n.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        },
        "x-n8n-env": [
          "N8N_AUTH_LOGIN_URL"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "example": "usuario@exemplo.com.br",
                    "format": "email"
                  },
                  "password": {
                    "type": "string",
                    "example": "senha-de-exemplo",
                    "format": "password"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": [
          "Autenticação"
        ],
        "summary": "Encerra a sessão apagando o cookie",
        "description": "**Tela:** Menu do usuário.",
        "security": [],
        "responses": {
          "200": {
            "description": "Cookie removido."
          }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "tags": [
          "Autenticação"
        ],
        "summary": "Cadastra usuário; a senha vira hash bcrypt no servidor",
        "description": "**Tela:** Cadastro.\n\n**Variável do webhook:** `N8N_AUTH_REGISTER_URL`.",
        "security": [],
        "responses": {
          "200": {
            "description": "Usuário cadastrado."
          },
          "409": {
            "description": "Usuário já existe.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno ou falha no n8n.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        },
        "x-n8n-env": [
          "N8N_AUTH_REGISTER_URL"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "cargo",
                  "first_name",
                  "last_name",
                  "password"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "example": "usuario@exemplo.com.br",
                    "format": "email"
                  },
                  "cargo": {
                    "type": "string",
                    "example": "Analista"
                  },
                  "first_name": {
                    "type": "string",
                    "example": "Nome"
                  },
                  "last_name": {
                    "type": "string",
                    "example": "Sobrenome"
                  },
                  "password": {
                    "type": "string",
                    "example": "senha-de-exemplo",
                    "format": "password"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": [
          "Autenticação"
        ],
        "summary": "Retorna o usuário da sessão",
        "description": "**Tela:** Todas as telas privadas.\n\n**Variável do webhook:** `N8N_AUTH_ME`.",
        "security": [
          {
            "sessao": []
          }
        ],
        "responses": {
          "200": {
            "description": "Dados do usuário (id, email, cargo, first_name, last_name)."
          },
          "401": {
            "description": "Sem sessão válida.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        },
        "x-n8n-env": [
          "N8N_AUTH_ME"
        ]
      },
      "put": {
        "tags": [
          "Autenticação"
        ],
        "summary": "Atualiza nome, sobrenome e cargo",
        "description": "**Tela:** Meu perfil.\n\n**Variável do webhook:** `N8N_UPDATE_USER_URL`.",
        "security": [
          {
            "sessao": []
          }
        ],
        "responses": {
          "200": {
            "description": "Usuário atualizado."
          },
          "401": {
            "description": "Sem sessão válida.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        },
        "x-n8n-env": [
          "N8N_UPDATE_USER_URL"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "first_name": {
                    "type": "string",
                    "example": "Nome"
                  },
                  "last_name": {
                    "type": "string",
                    "example": "Sobrenome"
                  },
                  "cargo": {
                    "type": "string",
                    "example": "Analista"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/update": {
      "post": {
        "tags": [
          "Autenticação"
        ],
        "summary": "Atualiza dados do usuário (não usada pelas telas atuais)",
        "description": "**Tela:** Nenhuma.\n\n**Variável do webhook:** `N8N_UPDATE_USER_URL`.",
        "security": [
          {
            "sessao": []
          }
        ],
        "responses": {
          "200": {
            "description": "Usuário atualizado."
          },
          "401": {
            "description": "Sem sessão válida.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        },
        "x-n8n-env": [
          "N8N_UPDATE_USER_URL"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "first_name": {
                    "type": "string",
                    "example": "Nome"
                  },
                  "last_name": {
                    "type": "string",
                    "example": "Sobrenome"
                  },
                  "cargo": {
                    "type": "string",
                    "example": "Analista"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/password": {
      "put": {
        "tags": [
          "Autenticação"
        ],
        "summary": "Troca a senha; a nova senha vira hash bcrypt no servidor",
        "description": "**Tela:** Alterar senha.\n\n**Variável do webhook:** `N8N_UPDATE_PASSWORD_URL`.",
        "security": [
          {
            "sessao": []
          }
        ],
        "responses": {
          "200": {
            "description": "Senha alterada."
          },
          "400": {
            "description": "Entrada inválida.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "401": {
            "description": "Sem sessão válida.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno ou falha no n8n.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        },
        "x-n8n-env": [
          "N8N_UPDATE_PASSWORD_URL"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "current_password",
                  "new_password"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "example": "usuario@exemplo.com.br",
                    "format": "email"
                  },
                  "current_password": {
                    "type": "string",
                    "example": "senha-atual",
                    "format": "password"
                  },
                  "new_password": {
                    "type": "string",
                    "example": "senha-nova",
                    "format": "password"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/upload-pdf": {
      "post": {
        "tags": [
          "AEP"
        ],
        "summary": "Envia uma planilha e recebe o relatório psicossocial em PDF",
        "description": "**Tela:** Relatório Psicossocial.\n\n**Variável do webhook:** `N8N_RECEBE_QUEST_URL`.",
        "security": [
          {
            "sessao": []
          }
        ],
        "responses": {
          "200": {
            "description": "PDF gerado.",
            "content": {
              "application/pdf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno ou falha no n8n.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        },
        "x-n8n-env": [
          "N8N_RECEBE_QUEST_URL"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "texto",
                  "data"
                ],
                "properties": {
                  "texto": {
                    "type": "string",
                    "example": "Ago/2025"
                  },
                  "data": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/ler-email-quest": {
      "post": {
        "tags": [
          "AEP"
        ],
        "summary": "Lê os e-mails de questionário do período",
        "description": "**Tela:** E-mail de Acesso – SOC.\n\n**Variável do webhook:** `N8N_LER_EMAILS_QUEST_URL`.",
        "security": [
