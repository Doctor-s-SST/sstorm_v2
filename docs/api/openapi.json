                  "dataInicio": {
                    "type": "string",
                    "format": "date",
                    "example": "2026-10-01"
                  },
                  "dataFim": {
                    "type": "string",
                    "format": "date",
                    "example": "2026-10-31"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/envio-email-quest": {
      "post": {
        "tags": [
          "AEP"
        ],
        "summary": "Envia o e-mail de acesso ao questionário SOC",
        "description": "**Tela:** E-mail de Acesso – SOC.\n\n**Variável do webhook:** `N8N_EMAIL_ACESSO_QUEST_URL`.",
        "security": [
          {
            "sessao": []
          }
        ],
        "responses": {
          "200": {
            "description": "Envio aceito."
          },
          "400": {
            "description": "Entrada inválida.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno ou falha no n8n.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        },
        "x-n8n-env": [
          "N8N_EMAIL_ACESSO_QUEST_URL"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "destinatarios"
                ],
                "properties": {
                  "remetente": {
                    "type": "object",
                    "properties": {
                      "nome": {
                        "type": "string",
                        "example": "Nome"
                      },
                      "sobrenome": {
                        "type": "string",
                        "example": "Sobrenome"
                      },
                      "cargo": {
                        "type": "string",
                        "example": "Analista"
                      },
                      "email": {
                        "type": "string",
                        "example": "usuario@exemplo.com.br",
                        "format": "email"
                      }
                    }
                  },
                  "destinatarios": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "email": {
                          "type": "string",
                          "example": "contato@empresa.com.br"
                        },
                        "empresa": {
                          "type": "string",
                          "example": "Empresa Exemplo"
                        },
                        "link": {
                          "type": "string",
                          "example": "https://exemplo.invalid/questionario"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/drive-docs": {
      "post": {
        "tags": [
          "Documentos"
        ],
        "summary": "Lista ou baixa documentos de condomínio gerados",
        "description": "**Tela:** Docs Condomínio.\n\n**Variável do webhook:** `N8N_DRIVE_DOCS_URL`.",
        "security": [
          {
            "sessao": []
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de arquivos (id, name) ou ZIP quando action = download."
          },
          "500": {
            "description": "Erro interno ou falha no n8n.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        },
        "x-n8n-env": [
          "N8N_DRIVE_DOCS_URL"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "action"
                ],
                "properties": {
                  "action": {
                    "type": "string",
                    "example": "list",
                    "enum": [
                      "list",
                      "download"
                    ]
                  },
                  "dataInicio": {
                    "type": "string",
                    "format": "date",
                    "example": "2026-10-01"
                  },
                  "dataFim": {
                    "type": "string",
                    "format": "date",
                    "example": "2026-10-31"
                  },
                  "fileId": {
                    "type": "string",
                    "example": "id-do-arquivo"
                  }
                }
              }
            }
          }
        }
      }
    },
